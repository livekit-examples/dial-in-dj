# Copy to .env.local (gitignored). Never commit real values.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini API key from Google AI Studio. Lyria RealTime does not work with Vertex AI.
GOOGLE_API_KEY=

# pipeline (STT-LLM-TTS DJ, default) | gemini (Gemini Live DJ) | direct (transcript = prompt)
DJ_PIPELINE=pipeline

# Demo page (web/): optional number shown as "Call the DJ"; unset = browser only
# DJ_DEMO_NUMBER=+14155551234
# DJ_TOKENS_PER_IP_PER_HOUR=20

# Outbound calling is off unless both are set (see docs/SETUP.md, section 6)
# ALLOW_OUTBOUND_CALLS=1
# SIP_OUTBOUND_TRUNK_ID=

# Optional tuning (see README "Tuning knobs")
# LYRIA_API_VERSION=v1alpha
# LYRIA_GUIDANCE=5.0
# LYRIA_AVOID=piano
# LYRIA_LOG_FILE=lyria_sends.jsonl
# DJ_LLM=google/gemma-4-31b-it

# Public deployments: end each session after N seconds (0 = no limit)
# DJ_MAX_SESSION_S=600
